includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    phpVersion: 80200

    paths:
        - src
        - energy-crm.php

    # Legacy ECRM_* classes are analysed only once they move under src/.
    # Scanning lets PHPStan resolve their names without reporting on them.
    scanDirectories:
        - includes
        - admin
        - public

    # Only the font metrics: they are PHP files holding arrays with thousands of
    # entries, they cost a great deal of memory to parse, and nothing of ours
    # names them. tfpdf.php itself must stay scanned — it defines the class the
    # calibration sheet extends.
    excludePaths:
        analyseAndScan:
            - includes/lib/tfpdf/font/*

    treatPhpDocTypesAsCertain: false

    # Each worker gets the full memory limit, so fewer of them means a smaller
    # peak. The WordPress stubs alone are a few hundred megabytes of signatures
    # before any of our code is read.
    parallel:
        maximumNumberOfProcesses: 2
