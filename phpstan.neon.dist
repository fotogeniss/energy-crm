includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    phpVersion: 80200

    paths:
        - src
        - energy-crm.php

    # Legacy ECRM_* classes are analysed only once they move under src/.
    # Scanning lets PHPStan resolve their names without reporting on them.
    scanDirectories:
        - includes
        - admin
        - public

    treatPhpDocTypesAsCertain: false
