includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    phpVersion: 80200

    paths:
        - src
        - energy-crm.php

    # Legacy ECRM_* classes are analysed only once they move under src/.
    # Scanning lets PHPStan resolve their names without reporting on them.
    scanDirectories:
        - includes
        - admin
        - public

    # The bundled tfpdf ships its font metrics as PHP files holding arrays with
    # thousands of entries. Parsing those exhausts the memory limit and buys
    # nothing: no code of ours references them by name.
    excludePaths:
        analyseAndScan:
            - includes/lib/*

    treatPhpDocTypesAsCertain: false
