{
    "name": "konstantinos/energy-crm",
    "description": "CRM για ενεργειακούς συνεργάτες — αιτήσεις και συμβάσεις παρόχων.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "EnergyCRM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnergyCRM\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.63.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "php tools/check-suite.php",
        "test:integration": "php tools/check-suite.php -c phpunit-integration.xml.dist",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "check:all": [
            "@check",
            "@test:integration"
        ]
    },
    "scripts-descriptions": {
        "test": "Unit tests — no WordPress, no database. Runs anywhere. Μέσω tools/check-suite.php, που απαιτεί γραμμή σύνοψης και όχι κωδικό εξόδου.",
        "test:integration": "Integration tests — needs a throwaway MySQL database. See docs/TESTING.md.",
        "check": "The pre-commit gate: lint, static analysis, unit tests.",
        "check:all": "Everything, including integration. Needs the database set up."
    }
}
