{
    "name": "konstantinos/energy-crm",
    "description": "CRM για ενεργειακούς συνεργάτες — αιτήσεις και συμβάσεις παρόχων.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "EnergyCRM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnergyCRM\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
