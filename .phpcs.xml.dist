<?xml version="1.0"?>
<ruleset name="Energy CRM">
    <description>
        PSR-12 as the baseline, plus the WordPress sniffs that catch real bugs.

        We deliberately do NOT use WordPress-Core/WordPress-Docs. Those rules
        assume code without type declarations, where the docblock carried the
        type information. Our code declares native types, so `@var string` above
        `private string $prefix` is duplication that goes stale. Short-array and
        Yoda rules are compatibility relics from PHP 5.x.

        What we keep from WPCS is the part that earns its keep: output escaping,
        nonce verification, input sanitisation and prepared SQL.
    </description>

    <file>src</file>
    <file>tests</file>
    <file>energy-crm.php</file>

    <!--
        The legacy tree runs in production and was checked by nothing at all,
        which is the wrong way round: it is the older code, handling the same
        ΑΦΜ and scanned identity documents, written before any of the current
        conventions existed.

        It is added here for the security sniffs only — escaping, nonces,
        sanitisation, prepared SQL. PSR-12 is switched off for it further down.
        Not because style does not matter, but because a few thousand tabs-vs-
        spaces errors would bury the handful of findings that do, and these
        files are being deleted one by one as they move under src/ anyway.
    -->
    <file>includes</file>
    <file>admin</file>
    <file>public</file>

    <!-- tFPDF is vendored third-party code. Not ours to restyle or to fix. -->
    <exclude-pattern>includes/lib/*</exclude-pattern>

    <!--
        Both of these are configuration, not code: they define the constants
        WordPress expects, before WordPress exists to be asked. Side effects
        and a global are the interface, not an oversight. wp-config.php has
        the same shape for the same reason.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/Integration/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/Integration/wp-tests-config.php</exclude-pattern>

        <!--
            Every legacy file opens with `if (! defined('ABSPATH')) exit;` above
            its class — the standard WordPress guard against direct access, and
            a side effect next to a symbol by definition. That is 30 warnings
            saying the same correct thing about a pattern we are not going to
            change. The PSR-12 exclusion above does not cover it, because this
            sniff is referenced by name here and that re-includes it.
        -->
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>

    <!--
        Integration tests query the database directly on purpose: the whole
        point is to compare what a repository returns against what is actually
        on disk. Going through the repository on both sides would test nothing.
        Caching advice is equally beside the point in a test.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>tests/Integration/*</exclude-pattern>
    </rule>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!--
        Baseline: modern PHP style — for the code that was written to it.

        The legacy tree predates every one of these conventions: tabs, Yoda
        conditions, no type declarations, `if (! defined('ABSPATH')) exit;`
        above a class declaration. Running PSR-12 over it would produce
        thousands of errors that nobody will ever act on, and the noise would
        hide the security findings this file is here to surface. Each legacy
        file gets held to PSR-12 the day it moves under src/, not before.
    -->
    <rule ref="PSR12">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>

    <!--
        A WordPress plugin entry file is by definition both a declaration
        (the ECRM_* constants) and a bootstrap (side effects). That is the
        contract WordPress imposes, so the sniff cannot apply here.
    -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>energy-crm.php</exclude-pattern>
    </rule>

    <!-- The WordPress rules worth enforcing. -->
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>

    <!--
        ## The four sniffs the legacy tree is exempt from, and why
        ##
        ## All four were run over it on 2026-08-10 and produced 195 findings.
        ## Every one was read. None was a vulnerability. What they have in
        ## common is that the safety is real but lives one step away from where
        ## the sniff is looking:
        ##
        ##   PreparedSQL          — the interpolated value is always a table
        ##                          name from ECRM_DB::table(), which is
        ##                          $wpdb->prefix . 'ecrm_' . <literal>. No call
        ##                          site passes a variable; that was checked.
        ##   PreparedSQLPlaceholders — the placeholders are built at runtime,
        ##                          `implode(',', array_fill(0, count($x), '%s'))`.
        ##                          The sniff counts one and finds six.
        ##   NonceVerification    — the admin handlers open with a guard()
        ##                          helper that calls check_admin_referer() and
        ##                          current_user_can(). Sniffs do not follow
        ##                          calls.
        ##   ValidatedSanitizedInput — the inputs go through a character
        ##                          whitelist, `preg_replace('/[^A-Za-z0-9\-]/', ...)`,
        ##                          which the sniff does not recognise as one.
        ##
        ## They stay fully enabled for src/. Turning them off here is a
        ## statement about this code as it stands, not a licence for new code —
        ## and new code does not go here, it goes under src/.
        ##
        ## EscapeOutput deliberately stays ON: it is the one that matters most
        ## for screens that print customer names and ΑΦΜ, and its findings were
        ## few enough to handle individually.
    -->
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.NonceVerification">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>

    <!--
        `src/Persistence/` is the layer whose entire job is talking to the
        database; flagging it for doing so says nothing. Caching is a real
        concern, but it belongs to a deliberate step with measurements behind
        it, not to a blanket warning on every query.

        Note that WordPress.DB.PreparedSQL stays enabled everywhere.
    -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>src/Persistence/*</exclude-pattern>

        <!--
            Same reasoning for the legacy tree, which is almost entirely direct
            queries: the sniff would fire on nearly every method and say
            nothing about safety. WordPress.DB.PreparedSQL — the one that
            actually catches injection — stays on there.
        -->
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>

    <!--
        ExceptionNotEscaped assumes exception messages reach a browser, which is
        true for template code. `src/Persistence/` produces no output at all,
        and its exceptions are built by UnknownColumns, which strips its input
        to [A-Za-z0-9_] before composing the message.

        Only this one check is lifted, and only here. Every other EscapeOutput
        rule stays active across the whole codebase.
    -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>src/Persistence/*</exclude-pattern>

        <!--
            Same argument for ECRM_FormFill, the only legacy site: it throws
            RuntimeException with a template key in the message, and it never
            produces output. An exception message is not HTML until someone
            prints it, and nothing here does.
        -->
        <exclude-pattern>includes/class-ecrm-formfill.php</exclude-pattern>
    </rule>

    <!--
        SlowDBQuery warns about querying users by meta. That is a fair warning
        in general and the wrong one here: the deep-hierarchy problem was solved
        in step 3 with a materialized path, and what remains in TeamRepository is
        a one-level lookup over a handful of rows. Removing the last meta query
        would mean a users table of our own, which is a bigger decision than a
        lint rule should force.
    -->
    <rule ref="WordPress.DB.SlowDBQuery">
        <exclude-pattern>src/Persistence/TeamRepository.php</exclude-pattern>
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP.DontExtract"/>

    <!--
        NoSilencedErrors is a discouraged-practice rule, not a security one, and
        all eleven legacy sites were read: `@ini_set('memory_limit')` and
        `@set_time_limit()`, which are disabled on plenty of hosts and warn when
        they are; `@unlink()` on a temp file that may already be gone; and
        `@simplexml_load_string()`, where suppressing the libxml warning and
        checking the return value — which the code does, every time — is the
        documented way to use it.

        Eleven `phpcs:ignore` comments saying that would be worse than the `@`.
        Still enforced for src/, where none of these idioms appear.
    -->
    <rule ref="WordPress.PHP.NoSilencedErrors">
        <exclude-pattern>energy-crm/includes/*</exclude-pattern>
        <exclude-pattern>energy-crm/admin/*</exclude-pattern>
        <exclude-pattern>energy-crm/public/*</exclude-pattern>
    </rule>

    <!-- Global constants must stay namespaced by prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ECRM"/>
                <element value="EnergyCRM"/>
            </property>
        </properties>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Tests may use assertions and fixtures that trip production-only sniffs. -->
    <rule ref="WordPress.Security">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.2"/>

    <!--
        PHPCompatibility is deliberately absent.

        Its job is to answer "does this code use syntax newer than the declared
        minimum PHP?". The stable release (9.3.5) predates enums, so it reads an
        enum body as though it were outside class scope and reports every $this
        inside it as an error. Worse than the noise: a parser that misreads the
        construct can just as easily miss a real problem inside it.

        The same guarantee comes from two places that do understand PHP 8.2:
        the platform requirement in composer.json, which stops installation on
        an older runtime, and phpVersion in phpstan.neon.dist.

        Reinstate once PHPCompatibility 10.0 is stable — it targets PHP 8.0+,
        but currently requires PHP_CodeSniffer 4.x and is still in alpha.
    -->

</ruleset>
