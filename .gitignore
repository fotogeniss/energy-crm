# Dependencies
/vendor/
/node_modules/

# Build output
/build/
/dist/
*.zip

# Tooling caches
/.phpunit.cache/
/.phpunit.result.cache
.phpstan-cache/
/tests/_output/
/coverage/

# Local / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*
*.swp
*~

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Generated / runtime artefacts
/languages/*.mo
*.log

# Provider source forms — large, reissued periodically, not ours to version.
/tools/source-forms/

# Test PDFs from tools/test-*-print.php — regenerated on every run.
/tools/output/

# Προσωρινά αρχεία εργασίας. Δύο χρήσεις, ίδια κατάληξη:
#   .commit-msg*.tmp.txt — τα ελληνικά πολυγραμμικά μηνύματα commit δεν περνούν
#     με -m μέσα από το cmd.exe, οπότε γράφονται εδώ και δίνονται με -F.
#   *.tmp.txt γενικά — καταγραφές εκτέλεσης (π.χ. η πλήρης έξοδος του phpunit
#     όταν το τερματικό την κόβει). Γράφονται για να ΜΕΤΡΗΘΟΥΝ, δεν εκδίδονται.
*.tmp.txt

# Προσωρινός κάδος: το VM δεν μπορεί να σβήσει, μόνο να μετακινήσει.
_to_delete/

# tools\measure.cmd -- πλήρης έξοδος σουίτας/wizard-smoke/μέτρησης dashboard.
# Ήδη καλυμμένο από το *.tmp.txt παραπάνω· η γραμμή μένει ρητή γιατί ο
# φάκελος υπάρχει ΜΟΝΟ γι' αυτόν τον λόγο -- τίποτα εδώ δεν προορίζεται
# ποτέ για commit.
docs/_measure/
