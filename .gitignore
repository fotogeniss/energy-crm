# Dependencies
/vendor/
/node_modules/

# Build output
/build/
/dist/
*.zip

# Tooling caches
/.phpunit.cache/
/.phpunit.result.cache
.phpstan-cache/
/tests/_output/
/coverage/

# Local / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*
*.swp
*~

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Generated / runtime artefacts
/languages/*.mo
*.log

# Provider source forms — large, reissued periodically, not ours to version.
/tools/source-forms/

# Test PDFs from tools/test-*-print.php — regenerated on every run.
/tools/output/

# Προσωρινό μήνυμα commit. Τα ελληνικά πολυγραμμικά μηνύματα δεν περνούν με
# -m μέσα από το cmd.exe, οπότε γράφονται εδώ και δίνονται με `git commit -F`.
.commit-msg*.tmp.txt
